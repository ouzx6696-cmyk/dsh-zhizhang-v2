{
  "name": "@zhizhang/dsh-workbench",
  "version": "3.0.0",
  "private": true,
  "description": "Author-controlled Fanqie and Toutiao workbench for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "check": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.client.json --noEmit",
    "lint": "npm run check",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.client.json",
    "dev": "npm run build && node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "docs:schema": "node scripts/schema-doc.mjs --write docs/schema.md",
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "npm run check && npm test",
    "bench": "node scripts/workspace-bench.mjs && node scripts/db-bench.mjs",
    "preflight": "node scripts/preflight.mjs",
    "deploy:touch": "node scripts/deploy.mjs --touch-only"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "exports": {
    ".": "./dist/server/host/plugin.js",
    "./client": "./dist/client/slot.js",
    "./locale/*.json": "./src/bundle/locale/*.json"
  },
  "files": [
    "dist",
    "src/client/workbench.html",
    "src/client/workbench.css",
    "src/bundle/cordis.patch.yml",
    "src/bundle/locale",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./src/bundle/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
